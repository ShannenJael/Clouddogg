# Copy this file to .env and fill in values before running the container.
# Do NOT commit .env to version control.

# The URL this app is served from (used by Next.js for absolute URLs)
# NEXT_PUBLIC_SITE_URL=https://clouddogg.com

# Required for contact and newsletter request delivery to service@clouddogg.com.
# Port 465 uses implicit TLS. Port 587 uses STARTTLS when supported by the server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
